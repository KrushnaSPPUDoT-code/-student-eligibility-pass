# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract artifacts (compiled output — regenerate with `npm run compile`)
contracts/managed/

# Wallet seed (sensitive)
*.seed

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.pid.lock

# Coverage directory
coverage/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# Midnight private-state LevelDB (runtime data, recreated on demand)
midnight-level-db/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local

# Frontend circuit artifacts (generated by npm run frontend:sync-circuit)
frontend/src/lib/contract/
frontend/public/circuit/
