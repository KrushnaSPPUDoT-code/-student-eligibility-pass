# Private Student Eligibility Pass — frontend configuration
# Copy to .env.local and adjust (`.env.local` is gitignored).

# Midnight network the DApp asks the wallet to connect to: preview | undeployed
VITE_NETWORK=preview

# Deployed contract address on that network (filled after `npm run deploy`).
VITE_CONTRACT_ADDRESS=

# Midnight public data / indexer (GraphQL). Defaults below are the Preview network.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Proof server used to generate zero-knowledge proofs.
#  * preview: a local proof server (recommended): http://localhost:6300
VITE_PROOF_SERVER_URL=http://localhost:6300

# Base URL of the ZK circuit artifacts served by this app
# (defaults to <BASE_URL>/circuit/student_pass — synced by frontend:sync-circuit).
# VITE_ZK_BASE_URL=/circuit/student_pass