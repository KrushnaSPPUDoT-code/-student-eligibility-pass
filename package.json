{
  "name": "student-eligibility-pass",
  "version": "1.0.0",
  "type": "module",
  "description": "Private Student Eligibility Pass — prove CGPA/attendance/credit eligibility on the Midnight Network (Compact / zero-knowledge) without revealing the underlying academic record.",
  "author": "SPPU Bootcamp — INTO the Midnight",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/student_pass.compact contracts/managed/student_pass",
    "build": "npx tsc --noEmit || true",
    "setup": "npx tsx src/setup.ts",
    "deploy": "npx tsx src/deploy.ts",
    "cli": "npx tsx src/cli.ts",
    "network": "npx tsx src/network.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state midnight-level-db",
    "test": "vitest run",
    "test:watch": "vitest",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "buffer": "^6.0.3",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": ["midnight", "blockchain", "zero-knowledge", "privacy", "student", "eligibility", "sppu"]
}
